[
  {
    "id": 1,
    "priority": 1,
    "condition": {
      "urlFilter": "*://*depop.com/*",
      "excludedInitiatorDomains": ["depop.com"]
    },
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "origin",
          "operation": "set",
          "value": "https://www.depop.com"
        },
        {
          "header": "referer",
          "operation": "set",
          "value": "https://www.depop.com/"
        }
      ],
      "responseHeaders": [
        {
          "header": "Access-Control-Allow-Origin",
          "operation": "set",
          "value": "*"
        }
      ]
    }
  }
]
